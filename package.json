{
  "name": "kure-kart",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/build_en_page.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "turn:prepare": "node tools/prepare_turn_config.mjs",
    "check:dist": "node tools/check_site.mjs dist",
    "data:download": "node tools/download_plateau.mjs",
    "data:convert": "node tools/convert_citygml.mjs",
    "data:rail": "node tools/fetch_rail.mjs && node tools/build_rail.mjs",
    "data:water": "node tools/fetch_water.mjs && node tools/build_water.mjs",
    "data:parks": "node tools/fetch_parks.mjs && node tools/build_parks.mjs",
    "data:route": "node tools/plan_route_osm.mjs && node tools/build_course.mjs",
    "data:lq": "node tools/build_lod2_atlas_lq.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "three": "^0.170.0",
    "trystero": "^0.25.4"
  }
}
